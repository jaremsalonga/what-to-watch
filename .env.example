# Copy to .env.local for local development (or run `vercel env pull`). Never commit real values.
# TMDB "API Read Access Token" (Settings > API on themoviedb.org). TMDB_API_KEY (v3) also works.
TMDB_READ_TOKEN=
# Long random strings, e.g. `openssl rand -hex 32`
TOKEN_SIGNING_SECRET=
IP_HASH_SECRET=
# At least 12 characters. Opens /admin.
ADMIN_PASSWORD=
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
